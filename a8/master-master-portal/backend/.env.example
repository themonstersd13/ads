PORT=8080
HOST=0.0.0.0

# User -> node routing. User mapping overrides role mapping.
# Format: user1:node1,user2:node2,user3:node3
USER_NODE_MAP=alice:node1,bob:node2,charlie:node3

# Role -> node routing for faculty demo.
# Example: admin writes to node1, teacher writes to node2, student writes to node3.
ROLE_NODE_MAP=admin:node1,teacher:node2,student:node3

FALLBACK_NODE=node1

# Node 1
NODE1_HOST=192.168.1.101
NODE1_PORT=5432
NODE1_DATABASE=lab_sync
NODE1_USER=postgres
NODE1_PASSWORD=postgres

# Node 2
NODE2_HOST=192.168.1.102
NODE2_PORT=5432
NODE2_DATABASE=lab_sync
NODE2_USER=postgres
NODE2_PASSWORD=postgres

# Node 3
NODE3_HOST=192.168.1.103
NODE3_PORT=5432
NODE3_DATABASE=lab_sync
NODE3_USER=postgres
NODE3_PASSWORD=postgres
